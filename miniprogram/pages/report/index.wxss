.page{min-height:100vh;display:flex;flex-direction:column;background:#f5f5f5;box-sizing:border-box;}
.search-bar{display:flex;align-items:center;gap:12rpx;padding:16rpx 20rpx;background:#fff;}
.search-input{flex:1;height:64rpx;line-height:64rpx;padding:0 24rpx;box-sizing:border-box;background:#f5f5f5;border-radius:32rpx;font-size:26rpx;color:#333;}
.search-btn{height:64rpx;line-height:64rpx;padding:0 24rpx;border-radius:12rpx;background:#e53935;color:#fff;font-size:24rpx;flex-shrink:0;}
.list{flex:1;height:0;padding:8rpx 0 24rpx;}
.report-card{margin:20rpx 24rpx 0;padding:28rpx 28rpx 20rpx;background:#fff;border-radius:16rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04);}
.card-title{font-size:32rpx;font-weight:700;color:#222;line-height:1.4;padding-bottom:20rpx;}
.card-divider{height:1px;background:#eee;margin-bottom:8rpx;}
.info-row{display:flex;align-items:flex-start;padding:14rpx 0;}
.info-label{width:180rpx;flex-shrink:0;font-size:26rpx;color:#888;line-height:1.5;}
.info-value{flex:1;font-size:26rpx;color:#333;line-height:1.5;word-break:break-all;}
.empty,.footer-tip{text-align:center;color:#999;padding:48rpx 24rpx;font-size:26rpx;}
