.page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.state.error {
  color: #666;
}

.retry {
  margin: 32rpx auto 0;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background: #e53935;
  color: #fff;
  font-size: 26rpx;
}

.body {
  flex: 1;
  height: 0;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.4;
  padding-bottom: 20rpx;
}

.divider {
  height: 1px;
  background: #eee;
  margin-bottom: 8rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

.value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

.preview-card {
  margin: 24rpx;
  padding: 64rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.preview-icon {
  display: inline-block;
  min-width: 96rpx;
  padding: 0 20rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 12rpx;
  background: rgba(229, 57, 53, 0.1);
  color: #e53935;
  font-size: 26rpx;
  font-weight: 600;
}

.preview-title {
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.preview-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.preview-tip.error {
  color: #e53935;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.download-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #e53935;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.download-btn.disabled {
  opacity: 0.6;
}
