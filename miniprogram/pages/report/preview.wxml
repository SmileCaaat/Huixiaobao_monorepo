<view class="page">
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{errorText}}" class="state error">
    <text>{{errorText}}</text>
    <view class="retry" bindtap="reload">重新加载</view>
  </view>

  <block wx:else>
    <scroll-view class="body" scroll-y>
      <view class="card">
        <view class="title">{{title}}</view>
        <view class="divider"></view>
        <view class="row">
          <text class="label">报告文件</text>
          <text class="value">{{fileName}}</text>
        </view>
        <view class="row">
          <text class="label">计划时间</text>
          <text class="value">{{planTimeText}}</text>
        </view>
        <view class="row">
          <text class="label">项目负责人</text>
          <text class="value">{{managerText}}</text>
        </view>
        <view class="row">
          <text class="label">维保操作员</text>
          <text class="value">{{operatorText}}</text>
        </view>
        <view class="row">
          <text class="label">生成时间</text>
          <text class="value">{{createTimeText}}</text>
        </view>
      </view>

      <view class="preview-card" bindtap="openPreview">
        <view class="preview-icon">{{fileTypeLabel}}</view>
        <view class="preview-title">报告预览</view>
        <view class="preview-tip" wx:if="{{previewReady}}">点击查看完整报告内容</view>
        <view class="preview-tip" wx:elif="{{previewLoading}}">正在准备预览文件...</view>
        <view class="preview-tip error" wx:else>{{previewError || '预览暂不可用'}}</view>
      </view>
    </scroll-view>

    <view class="bottom-bar">
      <view class="download-btn {{downloading ? 'disabled' : ''}}" bindtap="handleDownload">
        {{downloading ? '下载中...' : '下载'}}
      </view>
    </view>
  </block>
</view>
