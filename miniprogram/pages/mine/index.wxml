<view class="page">
  <view class="profile card">
    <view class="name">{{userName || loginName || '未命名用户'}}</view>
    <view class="meta">账号：{{loginName || '-'}}</view>
    <view class="meta">手机：{{phonenumber || '-'}}</view>
  </view>
  <view class="btn-primary logout" bindtap="handleLogout">退出登录</view>
  <tab-bar currentTab="{{3}}" />
</view>
