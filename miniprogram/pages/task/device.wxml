<view class="{{['page', 'data-v-588b9861', B && 'firetest']}}">
  <uni-nav-bar wx:if="{{b}}" class="data-v-588b9861" bindclickLeft="{{a}}" u-i="588b9861-0" bind:__l="__l" u-p="{{b}}"/>
  <view class="content data-v-588b9861">
    <scroll-view class="item-list data-v-588b9861" scroll-y>
      <view wx:for="{{c}}" wx:for-item="item" wx:key="z" class="item-card data-v-588b9861">
        <view class="item-info data-v-588b9861">
          <text class="item-name data-v-588b9861">{{item.a}}</text>
          <text class="item-code data-v-588b9861">{{item.b}}</text>
        </view>
        <view class="status-row data-v-588b9861">
          <view class="{{['check-btn', 'normal', 'data-v-588b9861', item.c && 'active']}}" catchtap="{{item.d}}">
            <text class="data-v-588b9861">{{item.e}}</text>
          </view>
          <view class="{{['check-btn', 'fault', 'data-v-588b9861', item.f && 'active']}}" catchtap="{{item.g}}">
            <text class="data-v-588b9861">{{item.h}}</text>
          </view>
          <view class="{{['check-btn', 'none', 'data-v-588b9861', item.i && 'active']}}" catchtap="{{item.j}}">
            <text class="data-v-588b9861">{{item.k}}</text>
          </view>
        </view>
        <view wx:if="{{item.l}}" class="fault-area data-v-588b9861" catchtap="{{item.p}}">
          <block wx:if="{{r0}}">
            <textarea class="fault-input data-v-588b9861" placeholder="请输入故障描述..." maxlength="{{500}}" auto-height value="{{item.m}}" bindinput="{{item.n}}"/>
          </block>
          <view class="save-btn data-v-588b9861" bindtap="{{item.o}}">
            <text class="data-v-588b9861">保存描述</text>
          </view>
        </view>
        <view class="notes-btn data-v-588b9861" catchtap="{{item.q}}">
          <text class="data-v-588b9861">{{item.r}}</text>
          <text wx:if="{{item.s}}" class="notes-badge data-v-588b9861">{{item.t}}</text>
        </view>
      </view>
      <view wx:if="{{d}}" class="loading-state data-v-588b9861">
        <text class="data-v-588b9861">加载中...</text>
      </view>
      <view wx:if="{{e}}" class="empty-state data-v-588b9861">
        <text class="empty-text data-v-588b9861">暂无检查项</text>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{f}}" class="modal-overlay data-v-588b9861" bindtap="{{A}}">
    <view class="modal-content data-v-588b9861" catchtap="{{z}}">
      <view class="modal-header data-v-588b9861">
        <text class="modal-title data-v-588b9861">其他说明</text>
        <view class="close-icon data-v-588b9861" bindtap="{{g}}">×</view>
      </view>
      <scroll-view class="modal-body data-v-588b9861" scroll-y>
        <view class="modal-padding data-v-588b9861">
          <view class="form-item data-v-588b9861">
            <text class="form-label data-v-588b9861">其他说明</text>
            <block wx:if="{{r0}}">
              <textarea class="form-textarea data-v-588b9861" placeholder="请输入其他说明..." maxlength="{{200}}" value="{{h}}" bindinput="{{i}}"/>
            </block>
          </view>
          <view class="form-item data-v-588b9861">
            <text class="form-label data-v-588b9861">附件</text>
            <view class="upload-area data-v-588b9861">
              <view class="upload-btn data-v-588b9861" bindtap="{{j}}">
                <text class="data-v-588b9861">拍照/上传附件</text>
              </view>
              <text wx:if="{{k}}" class="upload-tip data-v-588b9861">未选择文件</text>
              <text wx:else class="upload-tip data-v-588b9861">{{l}} 张图片</text>
            </view>
            <view wx:if="{{m}}" class="thumb-row data-v-588b9861">
              <view wx:for="{{n}}" wx:for-item="img" wx:key="d" class="thumb-wrap data-v-588b9861">
                <image class="thumb data-v-588b9861" src="{{img.a}}" mode="aspectFill" bindtap="{{img.b}}"></image>
                <view class="thumb-del data-v-588b9861" catchtap="{{img.c}}">×</view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="modal-footer data-v-588b9861">
        <view class="btn-cancel data-v-588b9861" bindtap="{{o}}">取消</view>
        <view class="btn-confirm data-v-588b9861" bindtap="{{p}}">保存</view>
      </view>
    </view>
  </view>
</view>
