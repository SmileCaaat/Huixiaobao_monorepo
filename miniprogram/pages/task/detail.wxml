<view class="page">
  <view class="task-banner" wx:if="{{taskInfo}}">
    <text class="task-banner-icon">✎</text>
    <text class="task-banner-name">{{taskInfo.taskName || '-'}}</text>
    <view class="task-banner-action" bindtap="goConclusion">结论</view>
  </view>
  <view class="task-banner" wx:else>
    <text class="task-banner-icon">✎</text>
    <text class="task-banner-name">维保任务</text>
    <view class="task-banner-action" bindtap="goConclusion">结论</view>
  </view>

  <view wx:if="{{categories.length === 0 && !loading}}" class="empty">暂无分类数据</view>

  <view class="list-wrap" wx:if="{{categories.length}}">
    <view
      class="sys-row"
      wx:for="{{categories}}"
      wx:key="categoryKey"
      bindtap="goSystem"
      data-key="{{item.categoryKey}}"
    >
      <view class="sys-main">
        <text class="sys-name">{{item.displayName}}</text>
        <view class="sys-stats">
          <text>总项 {{item.totalItems}}</text>
          <text>已完成 {{item.completedItems}}</text>
          <text>未完成 {{item.pendingItems}}</text>
        </view>
      </view>
      <view class="sys-right">
        <view class="status-pill {{item.statusClass}}">{{item.statusText}}</view>
        <text class="chevron">›</text>
      </view>
    </view>
  </view>

  <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
</view>
