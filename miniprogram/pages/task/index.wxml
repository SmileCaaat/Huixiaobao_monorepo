<view class="page">
  <view class="tabs">
    <view class="tab {{activeTab === 'periodic' ? 'active' : ''}}" data-tab="periodic" bindtap="switchTab">周期任务</view>
    <view class="tab {{activeTab === 'temporary' ? 'active' : ''}}" data-tab="temporary" bindtap="switchTab">临时任务</view>
  </view>
  <scroll-view class="list" scroll-y bindscrolltolower="loadMore">
    <view wx:if="{{list.length === 0 && !loading}}" class="empty">暂无维保任务</view>
    <view class="card" wx:for="{{list}}" wx:key="taskId" bindtap="goDetail" data-id="{{item.taskId}}">
      <view class="card-hd">
        <text class="title">{{item.taskName || '-'}}</text>
        <text class="badge {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="sub">负责人：{{item.managerName || '-'}}</view>
    </view>
    <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
    <view class="footer-tip" wx:if="{{noMore && list.length > 0}}">没有更多了</view>
  </scroll-view>
</view>
