<view class="page">
  <view class="section-title-row" wx:if="{{categoryName}}">
    <view class="section-title-left">
      <text class="section-icon">▦</text>
      <text class="section-title">{{categoryName}}</text>
    </view>
    <view class="all-normal-btn {{marking ? 'is-disabled' : ''}}" bindtap="onMarkAllNormal">
      <text class="all-normal-icon">✓</text>
      <text>全部正常</text>
    </view>
  </view>
  <view wx:if="{{equipments.length === 0 && !loading}}" class="empty">暂无设备</view>
  <view class="card item-card" wx:for="{{equipments}}" wx:key="equipmentKey" bindtap="goDevice" data-key="{{item.equipmentKey}}">
    <view class="card-hd">
      <view class="equipment-name-line">
        <text class="title">{{item.displayName}}</text>
        <text class="inspection-type-label">{{item.recordTypeLabel}}</text>
      </view>
      <text class="sub" wx:if="{{item.progressText}}">{{item.progressText}}</text>
    </view>
  </view>
  <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
</view>
