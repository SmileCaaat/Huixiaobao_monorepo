<view class="page">
  <view class="section-title" wx:if="{{categoryName}}">{{categoryName}}</view>
  <view wx:if="{{equipments.length === 0 && !loading}}" class="empty">暂无设备</view>
  <view class="card item-card" wx:for="{{equipments}}" wx:key="equipmentKey" bindtap="goDevice" data-key="{{item.equipmentKey}}">
    <view class="card-hd">
      <text class="title">{{item.displayName}}</text>
      <text class="sub" wx:if="{{item.progressText}}">{{item.progressText}}</text>
    </view>
  </view>
  <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
</view>
