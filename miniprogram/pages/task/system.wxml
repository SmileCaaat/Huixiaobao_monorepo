<view class="page">
  <view class="section-hd">
    <view class="section-left">
      <text class="section-icon">▦</text>
      <text class="section-title">{{categoryName || '系统分类'}}</text>
    </view>
    <view class="all-normal {{marking ? 'disabled' : ''}}" bindtap="onMarkAllNormal">
      <text class="all-normal-icon">✓</text>
      <text>全部正常</text>
    </view>
  </view>

  <view wx:if="{{equipments.length === 0 && !loading}}" class="empty">暂无设备</view>

  <view class="list-wrap" wx:if="{{equipments.length}}">
    <view
      class="eq-row"
      wx:for="{{equipments}}"
      wx:key="equipmentKey"
      bindtap="goDevice"
      data-key="{{item.equipmentKey}}"
    >
      <view class="eq-main">
        <view class="eq-name-line">
          <text class="eq-name">{{item.displayName}}</text>
          <text class="eq-type">{{item.typeLabel}}</text>
        </view>
        <view class="eq-stats">
          <text>总项 {{item.totalItems}}</text>
          <text>已完成 {{item.completedItems}}</text>
          <text>未完成 {{item.pendingItems}}</text>
        </view>
      </view>
      <view class="eq-right">
        <view class="status-pill {{item.statusClass}}">
          <text>{{item.statusText}}</text>
          <text class="pill-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-tip" wx:if="{{loading}}">加载中...</view>

  <view class="sheet-mask" wx:if="{{showDeviceSheet}}" catchtouchmove="preventMove" bindtap="closeDeviceSheet">
    <view class="sheet-panel" catchtap="preventMove">
      <view class="sheet-group">
        <view class="sheet-title">是否有该设备</view>
        <view class="sheet-item" data-value="yes" bindtap="onDeviceSheetSelect">有</view>
        <view class="sheet-item" data-value="none" bindtap="onDeviceSheetSelect">无</view>
      </view>
      <view class="sheet-cancel" bindtap="closeDeviceSheet">取消</view>
    </view>
  </view>
</view>
