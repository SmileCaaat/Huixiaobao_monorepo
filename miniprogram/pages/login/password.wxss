.page {
  padding: 48rpx 40rpx;
}

.field {
  box-sizing: border-box;
  height: 96rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.label {
  width: 100rpx;
  color: #666;
  flex-shrink: 0;
  line-height: 96rpx;
}

.input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  line-height: 96rpx;
}

.eye-btn {
  width: 48rpx;
  height: 48rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.eye-img {
  width: 36rpx;
  height: 36rpx;
}

.forgot {
  text-align: right;
  color: #999;
  margin-bottom: 40rpx;
}

.link {
  text-align: center;
  color: #e53935;
  margin-top: 40rpx;
}
