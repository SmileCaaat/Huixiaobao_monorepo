<view class="page">
  <view class="field">
    <text class="label">姓名</text>
    <input class="input" type="text" maxlength="30" placeholder="请输入真实姓名" value="{{userName}}" bindinput="onUserName" />
  </view>
  <view class="field">
    <text class="label">手机号</text>
    <input class="input" type="number" maxlength="11" placeholder="用作登录账号" value="{{phonenumber}}" bindinput="onPhone" />
  </view>
  <view class="field">
    <text class="label">密码</text>
    <input class="input" password="{{!showPwd}}" maxlength="20" placeholder="6-20 位" value="{{password}}" bindinput="onPassword" />
    <view class="eye-btn" bindtap="togglePwd">
      <image class="eye-img" src="{{showPwd ? '/static/icons/eye-open.png' : '/static/icons/eye-closed.png'}}" mode="aspectFit" />
    </view>
  </view>
  <view class="field">
    <text class="label">邀请码</text>
    <input class="input" type="text" maxlength="16" placeholder="部门提供的注册邀请码" value="{{inviteCode}}" bindinput="onInvite" />
  </view>
  <view class="btn-primary" bindtap="handleRegister">提交注册</view>
</view>
