<view class="page data-v-12565c11">
  <view class="top-deco data-v-12565c11"></view>
  <view class="header-box data-v-12565c11">
    <text class="title data-v-12565c11">注册账号</text>
    <text class="desc data-v-12565c11">{{e}}</text>
  </view>
  <view class="form-box data-v-12565c11">
    <view wx:if="{{h}}" class="org-box data-v-12565c11">
      <text class="data-v-12565c11">公司：{{f}}</text>
      <text class="data-v-12565c11">部门：{{g}}</text>
    </view>
    <view class="input-group data-v-12565c11">
      <view class="input-icon data-v-12565c11">?</view>
      <input class="input data-v-12565c11" type="number" placeholder="请输入手机号（作为登录账号）" maxlength="11" value="{{a}}" bindinput="{{b}}"/>
    </view>
    <view class="input-group data-v-12565c11">
      <view class="input-icon data-v-12565c11">?</view>
      <input class="input data-v-12565c11" type="text" placeholder="请输入您的姓名" value="{{c}}" bindinput="{{d}}"/>
    </view>
    <view class="input-group data-v-12565c11">
      <view class="input-icon data-v-12565c11">?</view>
      <input class="input data-v-12565c11" type="{{i}}" placeholder="请设置密码（5位以上）" value="{{j}}" bindinput="{{k}}"/>
      <view class="eye-btn data-v-12565c11" bindtap="{{m}}">{{l}}</view>
    </view>
    <view class="input-group data-v-12565c11">
      <view class="input-icon data-v-12565c11">?</view>
      <input class="input data-v-12565c11" type="{{n}}" placeholder="请再次输入密码" value="{{o}}" bindinput="{{p}}"/>
      <view class="eye-btn data-v-12565c11" bindtap="{{r}}">{{q}}</view>
    </view>
    <view class="input-group data-v-12565c11">
      <view class="input-icon data-v-12565c11">?</view>
      <input class="input data-v-12565c11" type="text" placeholder="请输入部门邀请码" maxlength="16" value="{{s}}" bindinput="{{t}}" bindblur="{{u}}"/>
    </view>
    <button class="{{['submit-btn', 'data-v-12565c11', v && 'active']}}" bindtap="{{w}}"> 注 册 </button>
    <view class="login-link data-v-12565c11">
      <text class="data-v-12565c11">已有账号？</text>
      <text class="link data-v-12565c11" bindtap="{{x}}">立即登录</text>
    </view>
  </view>
</view>
