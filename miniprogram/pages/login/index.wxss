.page {
  min-height: 100vh;
  padding: 120rpx 48rpx;
  background: linear-gradient(180deg, #ffebee 0%, #f5f5f5 40%);
  box-sizing: border-box;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  display: block;
  margin: 0 auto 32rpx;
}

.title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #c62828;
}

.sub {
  text-align: center;
  color: #888;
  margin: 16rpx 0 80rpx;
}

.btn-primary {
  margin-top: 24rpx;
}

.link {
  text-align: center;
  color: #e53935;
  margin-top: 40rpx;
}
