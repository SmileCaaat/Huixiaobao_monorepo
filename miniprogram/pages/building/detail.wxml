<view class="page" wx:if="{{detail}}">
  <view class="card">
    <view class="row"><text class="label">建筑名称</text><text class="value">{{detail.buildingName || '-'}}</text></view>
    <view class="row"><text class="label">地址</text><text class="value">{{detail.address || '-'}}</text></view>
    <view class="row"><text class="label">建筑类型</text><text class="value">{{detail.buildingTypeText || detail.buildingType || '-'}}</text></view>
    <view class="row"><text class="label">楼层数</text><text class="value">{{detail.floorCount != null ? detail.floorCount : '-'}}</text></view>
    <view class="row"><text class="label">建筑面积</text><text class="value">{{detail.area != null ? detail.area : '-'}}</text></view>
  </view>
  <view class="bottom-bar">
    <view class="btn-block" bindtap="goEdit">编辑</view>
  </view>
</view>
