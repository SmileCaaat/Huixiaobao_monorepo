@import "../../styles/biz.wxss";

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 0 160rpx;
  box-sizing: border-box;
}

.detail-card {
  margin: 0 24rpx;
  padding: 8rpx 28rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.detail-card .row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  line-height: 1.45;
}

.detail-card .row.last {
  border-bottom: none;
}

.detail-card .label {
  width: 240rpx;
  color: #333;
  flex-shrink: 0;
}

.detail-card .value {
  flex: 1;
  color: #666;
  word-break: break-all;
  text-align: left;
}

.photo-row {
  padding: 20rpx 0 8rpx;
}

.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eee;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}
