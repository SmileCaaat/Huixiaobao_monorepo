<view class="page">
  <view class="field">
    <text class="label">建筑名称</text>
    <input class="input" value="{{form.buildingName}}" data-field="buildingName" bindinput="onInput" placeholder="请输入" />
  </view>
  <view class="field">
    <text class="label">地址</text>
    <input class="input" value="{{form.address}}" data-field="address" bindinput="onInput" placeholder="请输入" />
  </view>
  <view class="field">
    <text class="label">建筑类型</text>
    <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex >= 0 ? typeIndex : 0}}" bindchange="onTypeChange">
      <view class="picker-val">{{form.buildingType || '请选择'}}</view>
    </picker>
  </view>
  <view class="field">
    <text class="label">楼层数</text>
    <input class="input" type="number" value="{{form.floorCount}}" data-field="floorCount" bindinput="onInput" placeholder="请输入" />
  </view>
  <view class="field">
    <text class="label">建筑面积</text>
    <input class="input" type="digit" value="{{form.area}}" data-field="area" bindinput="onInput" placeholder="请输入" />
  </view>
  <view class="bottom-bar">
    <view class="btn-block" bindtap="handleSubmit">保存</view>
  </view>
</view>
