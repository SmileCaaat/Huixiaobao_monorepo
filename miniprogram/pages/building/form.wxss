.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 0 180rpx;
  box-sizing: border-box;
}

.form-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.label {
  width: 240rpx;
  flex-shrink: 0;
  color: #222;
  font-size: 28rpx;
}

.input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 28rpx;
  color: #555;
  text-align: left;
}

.ph {
  color: #bbb;
}

.radios {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 40rpx;
}

.radio {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.radio .dot {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  box-sizing: border-box;
  position: relative;
}

.radio.active .dot {
  border-color: #e53935;
  background: #e53935;
}

.radio.active .dot::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 5rpx;
  width: 8rpx;
  height: 14rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

.item picker {
  flex: 1;
  min-width: 0;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.picker-val {
  font-size: 28rpx;
  color: #555;
}

.picker-ph {
  font-size: 28rpx;
  color: #bbb;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
  margin-left: 12rpx;
}

.photo-block {
  padding-top: 24rpx;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.thumb-wrap,
.thumb-add {
  width: 160rpx;
  height: 160rpx;
  position: relative;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eee;
  display: block;
}

.thumb-add {
  border-radius: 12rpx;
  background: #ececec;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cam-icon {
  width: 56rpx;
  height: 44rpx;
  border: 4rpx solid #bbb;
  border-radius: 8rpx;
  position: relative;
  box-sizing: border-box;
}

.cam-icon::before {
  content: "";
  position: absolute;
  top: -10rpx;
  left: 12rpx;
  width: 24rpx;
  height: 8rpx;
  background: #bbb;
  border-radius: 4rpx 4rpx 0 0;
}

.cam-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  margin: -9rpx 0 0 -9rpx;
  border: 3rpx solid #bbb;
  border-radius: 50%;
  box-sizing: border-box;
}

.thumb-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: #e53935;
  color: #fff;
  font-size: 22rpx;
  z-index: 2;
}

.thumb-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.save-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #e53935;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.save-btn.disabled {
  opacity: 0.6;
}
