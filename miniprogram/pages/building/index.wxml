<view class="page">
  <scroll-view class="list" scroll-y bindscrolltolower="loadMore">
    <view wx:if="{{list.length === 0 && !loading}}" class="empty">暂无建筑信息</view>
    <view class="card" wx:for="{{list}}" wx:key="buildingId" bindtap="goDetail" data-id="{{item.buildingId}}">
      <view class="card-hd">
        <text class="title">{{item.buildingName || '-'}}</text>
      </view>
      <view class="row"><text class="label">地址</text><text class="value">{{item.address || '-'}}</text></view>
      <view class="row"><text class="label">类型</text><text class="value">{{item.buildingTypeText || item.buildingType || '-'}}</text></view>
    </view>
    <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
    <view class="footer-tip" wx:if="{{noMore && list.length > 0}}">没有更多了</view>
  </scroll-view>
  <view class="fab" bindtap="goForm">+</view>
</view>
