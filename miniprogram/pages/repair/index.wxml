<view class="page">
  <view class="stats" wx:if="{{stats}}">
    <view class="stat-item"><text class="num">{{stats.assignedTotal || 0}}</text><text class="lbl">派发给我</text></view>
    <view class="stat-item"><text class="num">{{stats.reportedTotal || 0}}</text><text class="lbl">我上报的</text></view>
    <view class="stat-item"><text class="num">{{stats.pending || 0}}</text><text class="lbl">待处理</text></view>
  </view>
  <view class="tabs">
    <view class="tab {{activeTab === 'assigned' ? 'active' : ''}}" data-tab="assigned" bindtap="switchTab">派发给我</view>
    <view class="tab {{activeTab === 'reported' ? 'active' : ''}}" data-tab="reported" bindtap="switchTab">我上报的</view>
  </view>
  <scroll-view class="list" scroll-y bindscrolltolower="loadMore">
    <view wx:if="{{list.length === 0 && !loading}}" class="empty">暂无报修工单</view>
    <view class="card" wx:for="{{list}}" wx:key="repairId" bindtap="goDetail" data-id="{{item.repairId}}">
      <view class="card-hd">
        <text class="badge {{item.statusClass}}">{{item.statusText}}</text>
        <text class="sub">{{item.createTime || ''}}</text>
      </view>
      <view class="title line2">{{item.descSnippet || '-'}}</view>
      <view class="sub">紧急程度：{{item.urgencyText}}</view>
    </view>
    <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
    <view class="footer-tip" wx:if="{{noMore && list.length > 0}}">没有更多了</view>
  </scroll-view>
  <view class="fab" bindtap="goForm">+</view>
</view>
