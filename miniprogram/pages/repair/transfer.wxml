<view class="page">
  <view class="tip">仅显示与您同部门的可转派人员</view>
  <view class="search">
    <input
      class="input"
      placeholder="搜索姓名或电话"
      value="{{keyword}}"
      bindinput="onKeyword"
      confirm-type="search"
    />
  </view>
  <view class="list">
    <view class="empty" wx:if="{{loading}}">加载中...</view>
    <view class="empty" wx:elif="{{!filtered.length}}">{{errorMsg || '暂无同部门可转派人员'}}</view>
    <view
      class="item"
      wx:for="{{filtered}}"
      wx:key="userId"
      bindtap="onSelect"
      data-id="{{item.userId}}"
      data-name="{{item.userName}}"
    >
      <view class="avatar">{{item.userName[0] || '员'}}</view>
      <view class="info">
        <text class="name">{{item.userName}}</text>
        <text class="phone">{{item.displayPhone}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
