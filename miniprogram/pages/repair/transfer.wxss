.page { min-height: 100vh; background: #f5f5f5; }
.search { padding: 24rpx; background: #fff; }
.input {
  background: #f2f3f5; border-radius: 12rpx; height: 72rpx;
  padding: 0 24rpx; font-size: 28rpx;
}
.list {
  margin: 24rpx; background: #fff; border-radius: 16rpx; overflow: hidden;
}
.item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 24rpx; border-bottom: 1rpx solid #f0f0f0;
}
.name { font-size: 30rpx; color: #333; }
.phone { font-size: 26rpx; color: #2f80ed; }
.empty { padding: 80rpx 0; text-align: center; color: #999; }
