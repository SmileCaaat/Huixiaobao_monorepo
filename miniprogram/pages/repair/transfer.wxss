.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.tip {
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: #999;
  background: #fff7e6;
}

.search {
  padding: 20rpx 24rpx;
  background: #fff;
}

.input {
  background: #f2f3f5;
  border-radius: 12rpx;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.list {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(229, 57, 53, 0.12);
  color: #e53935;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  color: #222;
  font-weight: 600;
}

.phone {
  font-size: 26rpx;
  color: #666;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
  margin-left: 12rpx;
}

.empty {
  padding: 100rpx 24rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
