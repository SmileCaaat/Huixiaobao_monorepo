<view class="page">
  <view class="field"><text class="label">报修单位</text><text class="picker-val">{{companyName}}</text></view>
  <view class="field" wx:if="{{linked}}"><text class="label">系统名称</text><text class="picker-val">{{systemTypeName}}</text></view>
  <view class="field" wx:if="{{linked}}"><text class="label">设备名称</text><text class="picker-val">{{equipmentName}}</text></view>
  <view class="field" wx:if="{{linked}}"><text class="label">客户地址</text><text class="picker-val">{{customerAddress || '-'}}</text></view>
  <view class="field" wx:if="{{linked}}"><text class="label">是否上报</text><text class="picker-val">是</text></view>
  <picker mode="selector" range="{{urgencyOptions}}" range-key="label" value="{{urgencyIndex}}" bindchange="onUrgencyChange">
    <view class="field"><text class="label">紧急程度</text><text class="picker-val">{{urgencyText}}</text></view>
  </picker>
  <view class="field field-area">
    <text class="label">故障描述</text>
    <textarea class="input" placeholder="请输入故障描述" value="{{faultDescription}}" bindinput="onDescInput" maxlength="500" />
  </view>
  <view class="section-title">故障图片</view>
  <view class="thumb-row">
    <block wx:for="{{images}}" wx:key="index">
      <image class="thumb" src="{{item.tempPath || item.serverUrl}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" />
    </block>
    <view class="thumb-add" wx:if="{{images.length < 4}}" bindtap="chooseImage">+</view>
  </view>
  <view class="bottom-bar">
    <view class="btn-block" bindtap="submit">{{saving ? '提交中...' : '提交报修'}}</view>
  </view>
</view>
