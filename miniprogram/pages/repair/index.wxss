.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  color: #888;
  font-size: 28rpx;
}

.tab.active {
  color: #e53935;
  font-weight: 600;
  border-bottom: 4rpx solid #e53935;
}

.search-bar {
  background: #fff;
  padding: 16rpx 24rpx 20rpx;
}

.search-input {
  height: 68rpx;
  background: #f3f4f6;
  border-radius: 34rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.list {
  flex: 1;
  height: 0;
  padding: 8rpx 0 140rpx;
  box-sizing: border-box;
}

.card {
  margin: 16rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.status {
  font-size: 26rpx;
  font-weight: 600;
}

.status.warn { color: #ff9800; }
.status.ok { color: #4caf50; }
.status.muted { color: #999; }

.card-body {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.main-col {
  flex: 1;
  min-width: 0;
}

.row {
  display: flex;
  padding: 8rpx 0;
  font-size: 24rpx;
  line-height: 1.45;
}

.label {
  width: 140rpx;
  color: #666;
  flex-shrink: 0;
}

.value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

.urgency {
  align-self: center;
  flex-shrink: 0;
  min-width: 88rpx;
  text-align: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fff;
}

.urgency.u0 { background: #66bb6a; }
.urgency.u1 { background: #ffa726; }
.urgency.u2 { background: #ef5350; }

.empty, .footer-tip {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
  font-size: 26rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e53935;
  color: #fff;
  font-size: 56rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(229, 57, 53, 0.35);
  z-index: 20;
}
