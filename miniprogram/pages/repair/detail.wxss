@import "../../styles/biz.wxss";

.page { padding-bottom: 160rpx; }
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: #999;
  font-size: 28rpx;
}
.tab.active {
  color: #333;
  font-weight: 600;
  border-bottom: 4rpx solid #2f80ed;
}
.card {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04);
}
.card-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; }
.edit-link, .transfer-link { color: #2f80ed; font-size: 26rpx; }
.row {
  display: flex;
  padding: 12rpx 0;
  font-size: 26rpx;
}
.label { width: 160rpx; color: #999; flex-shrink: 0; }
.value { flex: 1; color: #333; word-break: break-all; }
.field-label { margin-top: 16rpx; color: #666; font-size: 26rpx; }
.textarea {
  margin-top: 12rpx;
  width: 100%;
  min-height: 180rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}
.count { text-align: right; color: #999; font-size: 22rpx; margin-top: 8rpx; }
.thumb-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.thumb { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #f0f0f0; }
.thumb-add {
  width: 140rpx; height: 140rpx; border-radius: 12rpx;
  background: #f5f7fa; color: #999; display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}
.btn-save {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #2f80ed;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.06);
}
.btn {
  flex: 1; height: 80rpx; line-height: 80rpx; text-align: center;
  border-radius: 12rpx; font-size: 28rpx;
}
.btn.primary { background: #2f80ed; color: #fff; }
.btn.success { background: #27ae60; color: #fff; }
.btn.ghost { background: #fff; color: #eb5757; border: 1rpx solid #eb5757; }
.progress {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12rpx 8rpx 24rpx; border-bottom: 1rpx solid #f0f0f0; margin-bottom: 8rpx;
}
.step { display: flex; flex-direction: column; align-items: center; color: #bbb; font-size: 22rpx; }
.step.on { color: #27ae60; }
.step .icon { font-size: 36rpx; margin-bottom: 8rpx; }
.arrow { color: #ddd; font-size: 36rpx; }
.log-item { padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.log-text { font-size: 28rpx; color: #333; }
.log-time { margin-top: 8rpx; font-size: 22rpx; color: #999; }
.log-empty { padding: 40rpx 0; text-align: center; color: #999; }
