.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 0 180rpx;
  box-sizing: border-box;
}

.form-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.item.column {
  flex-direction: column;
  align-items: stretch;
  padding: 20rpx 0;
}

.label {
  width: 160rpx;
  flex-shrink: 0;
  color: #222;
  font-size: 28rpx;
}

.value, .input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #555;
}

.input {
  height: 96rpx;
  line-height: 96rpx;
}

.ph { color: #bbb; }

.item picker { flex: 1; min-width: 0; }

.picker-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.equip-item { gap: 8rpx; }

.equip-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.equip-pick {
  flex-shrink: 0;
  width: 64rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.equip-pick.disabled { opacity: 0.35; }

.right-tools {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.clear {
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
  margin-left: 8rpx;
}

.switch-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.switch-text { font-size: 28rpx; color: #555; }

.radios {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  flex-wrap: wrap;
}

.radio {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.radio .dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  box-sizing: border-box;
  position: relative;
}

.radio.active .dot {
  border-color: #e53935;
  background: #e53935;
}

.radio.active .dot::after {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 4rpx;
  width: 7rpx;
  height: 12rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
  margin-top: 8rpx;
}

.count {
  text-align: right;
  color: #999;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.photo-block { padding-top: 20rpx; }

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.thumb-wrap, .thumb-add {
  width: 140rpx;
  height: 140rpx;
  position: relative;
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #eee;
  display: block;
}

.thumb-add {
  border-radius: 12rpx;
  background: #f0f0f0;
  color: #bbb;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: #e53935;
  color: #fff;
  font-size: 22rpx;
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.save-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #e53935;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.save-btn.disabled { opacity: 0.6; }

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}

.picker-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
  color: #333;
}

.picker-hd .title {
  color: #111;
  font-weight: 600;
}

.picker-hd .confirm {
  color: #e53935;
}

.picker-view {
  height: 440rpx;
}

.picker-item {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}

.picker-item-active {
  color: #111;
  font-weight: 700;
  font-size: 34rpx;
}
