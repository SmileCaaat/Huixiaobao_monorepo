<view class="page" wx:if="{{detail}}">
  <view class="card">
    <view class="card-hd">
      <text class="badge {{statusClass}}">{{statusText}}</text>
      <text class="sub">{{detail.createTime || ''}}</text>
    </view>
    <view class="row"><text class="label">紧急程度</text><text class="value">{{urgencyText}}</text></view>
    <view class="row"><text class="label">报修单位</text><text class="value">{{detail.companyName || '-'}}</text></view>
    <view class="row"><text class="label">故障描述</text><text class="value">{{detail.faultDescription || '-'}}</text></view>
    <view class="row" wx:if="{{detail.repairPerson}}"><text class="label">处理人</text><text class="value">{{detail.repairPerson}}</text></view>
    <view class="row" wx:if="{{detail.repairDescription}}"><text class="label">处理说明</text><text class="value">{{detail.repairDescription}}</text></view>
  </view>
  <view class="section-title" wx:if="{{faultImages.length}}">故障图片</view>
  <view class="thumb-row" wx:if="{{faultImages.length}}">
    <image wx:for="{{faultImages}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" bindtap="previewFaultImage" data-index="{{index}}" />
  </view>
  <view class="bottom-bar" wx:if="{{canStart}}">
    <view class="btn-block" bindtap="handleStart">开始处理</view>
  </view>
  <block wx:if="{{canComplete}}">
    <view class="section-title">处理结果</view>
    <view class="field field-area">
      <textarea class="input" placeholder="请输入处理说明" value="{{repairDescription}}" bindinput="onRepairDescInput" maxlength="500" />
    </view>
    <view class="thumb-row">
      <block wx:for="{{completeImages}}" wx:key="index">
        <image class="thumb" src="{{item.tempPath || item.serverUrl}}" mode="aspectFill" />
      </block>
      <view class="thumb-add" wx:if="{{completeImages.length < 4}}" bindtap="chooseCompleteImage">+</view>
    </view>
    <view class="bottom-bar">
      <view class="btn-block" bindtap="handleComplete">{{submitting ? '提交中...' : '完成处理'}}</view>
    </view>
  </block>
</view>
