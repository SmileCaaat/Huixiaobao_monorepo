<view class="page">
  <view class="field">
    <text class="label">设备名称</text>
    <input class="input" value="{{form.equipmentName}}" data-field="equipmentName" bindinput="onInput" placeholder="请输入" />
  </view>
  <view class="field">
    <text class="label">所在位置</text>
    <input class="input" value="{{form.location}}" data-field="location" bindinput="onInput" placeholder="请输入" />
  </view>
  <view class="field">
    <text class="label">所属系统</text>
    <input class="input" value="{{form.systemName}}" data-field="systemName" bindinput="onInput" placeholder="请输入" />
  </view>
  <view class="field">
    <text class="label">型号</text>
    <input class="input" value="{{form.model}}" data-field="model" bindinput="onInput" placeholder="请输入" />
  </view>
  <view class="field">
    <text class="label">生产厂家</text>
    <input class="input" value="{{form.manufacturer}}" data-field="manufacturer" bindinput="onInput" placeholder="请输入" />
  </view>
  <view class="field">
    <text class="label">建筑</text>
    <picker mode="selector" range="{{buildingOptions}}" range-key="buildingName" value="{{buildingIndex}}" bindchange="onBuildingChange">
      <view class="picker-val">{{form.buildingName || '请选择'}}</view>
    </picker>
  </view>
  <view class="bottom-bar">
    <view class="btn-block" bindtap="handleSubmit">保存</view>
  </view>
</view>
