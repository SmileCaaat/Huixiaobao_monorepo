<view class="page">
  <scroll-view class="list" scroll-y bindscrolltolower="loadMore">
    <view wx:if="{{list.length === 0 && !loading}}" class="empty">暂无设备</view>
    <view class="card" wx:for="{{list}}" wx:key="equipmentId" bindtap="goDetail" data-id="{{item.equipmentId}}">
      <view class="card-hd">
        <text class="title">{{item.equipmentName || '-'}}</text>
      </view>
      <view class="row"><text class="label">编号</text><text class="value">{{item.equipmentCode || '-'}}</text></view>
      <view class="row"><text class="label">位置</text><text class="value">{{item.location || '-'}}</text></view>
      <view class="row"><text class="label">系统</text><text class="value">{{item.systemName || '-'}}</text></view>
    </view>
    <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
    <view class="footer-tip" wx:if="{{noMore && list.length > 0}}">没有更多了</view>
  </scroll-view>
  <view class="fab" bindtap="goForm">+</view>
</view>
