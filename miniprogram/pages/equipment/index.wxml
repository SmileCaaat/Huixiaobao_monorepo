<view class="page">
  <view wx:if="{{categories.length === 0}}" class="empty">暂无分类</view>
  <view class="grid">
    <view class="grid-item" wx:for="{{categories}}" wx:key="value" bindtap="goList" data-category="{{item.value}}">
      <text class="grid-text">{{item.label}}</text>
    </view>
  </view>
</view>
