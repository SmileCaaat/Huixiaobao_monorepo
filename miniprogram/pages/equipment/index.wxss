@import "../../styles/biz.wxss";
.grid { display: flex; flex-wrap: wrap; padding: 16rpx; box-sizing: border-box; }
.grid-item { width: 50%; padding: 12rpx; box-sizing: border-box; }
.grid-text { display: block; background: #fff; border-radius: 16rpx; padding: 36rpx 24rpx; text-align: center; font-size: 28rpx; color: #333; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05); }
