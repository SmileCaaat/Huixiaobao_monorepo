<view class="page" wx:if="{{detail}}">
  <view class="card">
    <view class="row"><text class="label">设备名称</text><text class="value">{{detail.equipmentName || '-'}}</text></view>
    <view class="row"><text class="label">设备编号</text><text class="value">{{detail.equipmentCode || '-'}}</text></view>
    <view class="row"><text class="label">所在位置</text><text class="value">{{detail.location || '-'}}</text></view>
    <view class="row"><text class="label">所属系统</text><text class="value">{{detail.systemName || '-'}}</text></view>
    <view class="row"><text class="label">型号</text><text class="value">{{detail.model || '-'}}</text></view>
    <view class="row"><text class="label">生产厂家</text><text class="value">{{detail.manufacturer || '-'}}</text></view>
    <view class="row"><text class="label">建筑</text><text class="value">{{detail.buildingName || '-'}}</text></view>
  </view>
  <view class="bottom-bar">
    <view class="btn-block" bindtap="goEdit">编辑</view>
  </view>
</view>
