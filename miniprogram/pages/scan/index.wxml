<view class="page">
  <view class="btn-primary scan-btn" bindtap="startScan">开始扫码</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{result}}" class="card">
    <view class="row">名称：{{result.equipmentName || '-'}}</view>
    <view class="row">编码：{{result.equipmentCode || '-'}}</view>
    <view class="row">位置：{{result.location || '-'}}</view>
    <view class="btn-ghost" bindtap="goDetail">查看详情</view>
  </view>
  <view wx:else class="empty-tip">扫描设备二维码查询信息</view>
  <tab-bar currentTab="{{2}}" />
</view>
