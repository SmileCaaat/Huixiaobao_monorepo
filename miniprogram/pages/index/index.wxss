.page {
  padding-bottom: 140rpx;
}

.banner {
  background: linear-gradient(135deg, #e53935, #c62828);
  padding: 40rpx 32rpx 48rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.banner-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.banner-img {
  width: 120rpx;
  height: 120rpx;
}

.project-card {
  margin: -28rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.project-info {
  flex: 1;
}

.project-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.project-addr {
  display: block;
  margin-top: 8rpx;
  color: #999;
  font-size: 24rpx;
}

.project-switch {
  color: #e53935;
  padding: 12rpx 20rpx;
  border: 1px solid #e53935;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.section {
  margin: 32rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.app-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.app-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.app-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.app-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.app-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #444;
}

.stats-section {
  display: flex;
  margin: 24rpx;
  gap: 20rpx;
}

.stats-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.stats-title {
  color: #888;
  font-size: 24rpx;
}

.stats-num {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.stats-success {
  color: #43a047;
}

.stats-label {
  color: #999;
  font-size: 22rpx;
}

.home-error {
  color: #e53935;
  text-align: center;
  padding: 0 24rpx 24rpx;
  font-size: 24rpx;
}

.bottom-placeholder {
  height: 40rpx;
}
