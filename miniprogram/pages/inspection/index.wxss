.page { min-height: 100vh; background: #f5f5f5; display: flex; flex-direction: column; }
.search-bar { display: flex; align-items: center; gap: 12rpx; background: #fff; padding: 16rpx 20rpx; }
.search-input { flex: 1; height: 64rpx; background: #f5f5f5; border-radius: 32rpx; padding: 0 24rpx; font-size: 26rpx; }
.date-btn, .search-btn { height: 64rpx; line-height: 64rpx; padding: 0 20rpx; border-radius: 12rpx; background: #f5f5f5; font-size: 24rpx; color: #666; }
.search-btn { background: #e53935; color: #fff; }
.list { flex: 1; height: 0; padding: 20rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05); }
.card-hd { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.title { font-size: 30rpx; font-weight: 600; color: #333; }
.date { font-size: 22rpx; color: #999; }
.row { display: flex; align-items: center; padding: 8rpx 0; }
.label { width: 120rpx; color: #999; font-size: 24rpx; }
.value { flex: 1; color: #333; font-size: 24rpx; }
.count { margin-left: 16rpx; color: #666; font-size: 24rpx; }
.badge { padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; }
.ok { background: rgba(76,175,80,.12); color: #4caf50; }
.bad { background: rgba(244,67,54,.12); color: #f44336; }
.empty, .footer-tip { text-align: center; color: #999; padding: 40rpx 0; font-size: 26rpx; }
.fab { position: fixed; right: 40rpx; bottom: 80rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: #e53935; color: #fff; font-size: 56rpx; line-height: 100rpx; text-align: center; box-shadow: 0 8rpx 20rpx rgba(229,57,53,.35); }
