.page { min-height: 100vh; background: #f5f5f5; padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 10rpx 24rpx 24rpx; }
.row { display: flex; align-items: flex-start; padding: 18rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.row.column { flex-direction: column; gap: 12rpx; }
.label { width: 160rpx; color: #999; font-size: 26rpx; flex-shrink: 0; }
.value { flex: 1; color: #333; font-size: 26rpx; }
.badge { padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; }
.ok { background: rgba(76,175,80,.12); color: #4caf50; }
.bad { background: rgba(244,67,54,.12); color: #f44336; }
.images { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img { width: 160rpx; height: 160rpx; border-radius: 8rpx; }
