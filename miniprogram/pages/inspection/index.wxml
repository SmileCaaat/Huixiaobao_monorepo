<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="请输入关键字" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="handleSearch" />
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
      <view class="date-btn">{{selectedDate || '日期'}}</view>
    </picker>
    <view class="search-btn" bindtap="handleSearch">查询</view>
  </view>

  <scroll-view class="list" scroll-y bindscrolltolower="loadMore">
    <view wx:if="{{list.length === 0 && !loading}}" class="empty">暂无巡检测试记录</view>
    <view class="card" wx:for="{{list}}" wx:key="inspectionId" bindtap="goDetail" data-id="{{item.inspectionId}}">
      <view class="card-hd">
        <text class="title">{{item.equipmentName || '-'}}</text>
        <text class="date">{{item.inspectionTime || item.createTime || ''}}</text>
      </view>
      <view class="row"><text class="label">客户</text><text class="value">{{item.companyName || '-'}}</text></view>
      <view class="row"><text class="label">位置</text><text class="value">{{item.location || '-'}}</text></view>
      <view class="row"><text class="label">楼层</text><text class="value">{{item.floor || '-'}}</text></view>
      <view class="row">
        <text class="label">结果</text>
        <text class="badge {{item.equipmentStatus === '1' ? 'bad' : 'ok'}}">{{item.equipmentStatus === '1' ? '异常' : '正常'}}</text>
        <text class="count">x{{item.equipmentCount || 1}}</text>
      </view>
      <view class="row"><text class="label">操作员</text><text class="value">{{item.inspectorName || '-'}}</text></view>
    </view>
    <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
    <view class="footer-tip" wx:if="{{noMore && list.length > 0}}">没有更多了</view>
  </scroll-view>

  <view class="fab" bindtap="goAdd">+</view>
</view>
