<view class="page" wx:if="{{detail}}">
  <view class="card">
    <view class="row"><text class="label">单位名称</text><text class="value">{{detail.companyName || '-'}}</text></view>
    <view class="row"><text class="label">维保类型</text><text class="value">{{typeText}}</text></view>
    <view class="row"><text class="label">建筑名称</text><text class="value">{{detail.buildingName || '-'}}</text></view>
    <view class="row"><text class="label">所在楼层</text><text class="value">{{detail.floor || '-'}}</text></view>
    <view class="row"><text class="label">系统名称</text><text class="value">{{detail.systemName || '-'}}</text></view>
    <view class="row"><text class="label">设备名称</text><text class="value">{{detail.equipmentName || '-'}}</text></view>
    <view class="row"><text class="label">设备数量</text><text class="value">{{detail.equipmentCount || 1}}</text></view>
    <view class="row"><text class="label">具体位置</text><text class="value">{{detail.location || '-'}}</text></view>
    <view class="row"><text class="label">巡检时间</text><text class="value">{{detail.inspectionTime || '-'}}</text></view>
    <view class="row"><text class="label">登记日期</text><text class="value">{{detail.createTime || '-'}}</text></view>
    <view class="row"><text class="label">设备状态</text><text class="badge {{detail.equipmentStatus === '1' ? 'bad' : 'ok'}}">{{detail.equipmentStatus === '1' ? '异常' : '正常'}}</text></view>
    <view class="row"><text class="label">操作员</text><text class="value">{{detail.inspectorName || '-'}}</text></view>
    <view class="row"><text class="label">维保标准</text><text class="value">{{detail.maintenanceStandard || '-'}}</text></view>
    <view class="row column"><text class="label">详细备注</text><text class="value">{{detail.remark || '无'}}</text></view>
    <view class="row column" wx:if="{{images.length}}">
      <text class="label">现场图片</text>
      <view class="images">
        <image wx:for="{{images}}" wx:key="*this" class="img" src="{{item}}" mode="aspectFill" bindtap="preview" data-url="{{item}}" />
      </view>
    </view>
  </view>
</view>
