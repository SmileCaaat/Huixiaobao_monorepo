.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 160rpx; }
.form { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 8rpx 24rpx; }
.item { display: flex; align-items: center; min-height: 88rpx; border-bottom: 1rpx solid #f0f0f0; gap: 16rpx; }
.item.column { flex-direction: column; align-items: stretch; padding: 20rpx 0; }
.label { width: 160rpx; color: #666; font-size: 28rpx; flex-shrink: 0; }
.label.required::before { content: '*'; color: #e53935; margin-right: 6rpx; }
.readonly, .value { flex: 1; color: #333; font-size: 28rpx; }
.placeholder { flex: 1; color: #999; font-size: 28rpx; }
.arrow { color: #ccc; font-size: 36rpx; }
.radios { display: flex; gap: 24rpx; flex-wrap: wrap; }
.radio { font-size: 26rpx; color: #333; }
.stepper { margin-left: auto; display: flex; align-items: center; gap: 20rpx; }
.step-btn { width: 52rpx; height: 52rpx; border-radius: 8rpx; background: #f5f5f5; text-align: center; line-height: 52rpx; }
.step-val { min-width: 40rpx; text-align: center; }
.textarea { width: 100%; min-height: 140rpx; background: #f9f9f9; border-radius: 8rpx; padding: 16rpx; box-sizing: border-box; font-size: 26rpx; }
.count { text-align: right; color: #999; font-size: 22rpx; }
.status-row { margin-left: auto; display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; }
.images { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-wrap { position: relative; width: 140rpx; height: 140rpx; }
.img { width: 140rpx; height: 140rpx; border-radius: 8rpx; }
.img-del { position: absolute; top: -10rpx; right: -10rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #e53935; color: #fff; text-align: center; line-height: 36rpx; font-size: 24rpx; }
.img-add { width: 140rpx; height: 140rpx; border: 2rpx dashed #ccc; border-radius: 8rpx; color: #999; font-size: 56rpx; display: flex; align-items: center; justify-content: center; }
.save-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.06); }
.save-btn { background: #e53935; color: #fff; border-radius: 12rpx; }

.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.45); display: flex; align-items: flex-end; z-index: 1000; }
.picker-panel { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; }
.picker-hd { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 30rpx; border-bottom: 1rpx solid #eee; font-size: 28rpx; color: #666; }
.picker-hd .title { color: #333; font-weight: 600; }
.picker-hd .confirm { color: #e53935; }
.picker-view { height: 440rpx; }
.picker-item { height: 80rpx; line-height: 80rpx; text-align: center; font-size: 28rpx; color: #999; }
.picker-item-active { color: #222; font-weight: 700; font-size: 32rpx; }
.date-picker-view { padding: 0 12rpx; }

/* 楼层网格弹窗 */
.floor-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}
.floor-sheet-title {
  text-align: center;
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  padding: 28rpx 24rpx 16rpx;
}
.floor-scroll {
  max-height: 52vh;
  padding: 8rpx 24rpx 16rpx;
  box-sizing: border-box;
}
.floor-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.floor-cell {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.floor-cell.active {
  color: #e53935;
  background: #ffebee;
  border-color: #e53935;
  font-weight: 600;
}
.floor-cancel {
  margin: 8rpx 24rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 12rpx;
}
