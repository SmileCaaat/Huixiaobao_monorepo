<view class="page">
  <view class="form">
    <view class="item">
      <text class="label">单位名称</text>
      <text class="readonly">{{form.companyName || '未选择公司'}}</text>
    </view>

    <view class="item">
      <text class="label required">维保类型</text>
      <radio-group class="radios" bindchange="onTypeChange">
        <label wx:for="{{typeOptions}}" wx:key="value" class="radio">
          <radio value="{{item.value}}" checked="{{form.inspectionType === item.value}}" color="#e53935" />{{item.label}}
        </label>
      </radio-group>
    </view>

    <view class="item" bindtap="openBuildingPicker">
      <text class="label required">建筑名称</text>
      <text class="{{form.buildingName ? 'value' : 'placeholder'}}">{{form.buildingName || '请选择'}}</text>
      <text class="arrow">›</text>
    </view>

    <view class="item" bindtap="openFloorSheet">
      <text class="label required">所在楼层</text>
      <text class="{{form.floor ? 'value' : 'placeholder'}}">{{form.floor || '请选择'}}</text>
      <text class="arrow">›</text>
    </view>

    <view class="item" bindtap="openSystemPicker">
      <text class="label required">系统名称</text>
      <text class="{{form.systemName ? 'value' : 'placeholder'}}">{{form.systemName || '请选择'}}</text>
      <text class="arrow">›</text>
    </view>

    <view class="item" bindtap="openEquipmentPicker">
      <text class="label required">设备名称</text>
      <text class="{{form.equipmentName ? 'value' : 'placeholder'}}">{{form.equipmentName || '请选择'}}</text>
      <text class="arrow">›</text>
    </view>

    <view class="item">
      <text class="label required">设备数量</text>
      <view class="stepper">
        <view class="step-btn" bindtap="decCount">-</view>
        <text class="step-val">{{form.equipmentCount}}</text>
        <view class="step-btn" bindtap="incCount">+</view>
      </view>
    </view>

    <view class="item inline-field">
      <text class="label required">具体位置</text>
      <textarea class="inline-textarea" auto-height maxlength="200" placeholder="必填" value="{{form.location}}" bindinput="onLocationInput" show-confirm-bar="{{false}}" />
      <text class="inline-count">{{form.location.length || 0}}/200</text>
    </view>

    <view class="item" bindtap="openDateSheet">
      <text class="label required">巡检时间</text>
      <text class="{{datePart ? 'value' : 'placeholder'}}">{{datePart || '请选择'}}</text>
      <text class="arrow">›</text>
    </view>

    <view class="item">
      <text class="label">设备状态</text>
      <view class="status-row">
        <text>{{form.equipmentStatus === '0' ? '正常' : '异常'}}</text>
        <switch checked="{{form.equipmentStatus === '0'}}" color="#e53935" bindchange="onStatusChange" />
      </view>
    </view>

    <view class="item inline-field">
      <text class="label">详细备注</text>
      <textarea class="inline-textarea" auto-height maxlength="500" placeholder="请输入" value="{{form.remark}}" bindinput="onRemarkInput" show-confirm-bar="{{false}}" />
      <text class="inline-count">{{form.remark.length || 0}}/500</text>
    </view>

    <view class="item column">
      <text class="label">现场图片</text>
      <view class="images">
        <view class="img-wrap" wx:for="{{images}}" wx:key="index">
          <image class="img" src="{{item.tempPath || item.serverUrl}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" />
          <view class="img-del" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
        <view class="img-add" wx:if="{{images.length < 4}}" bindtap="chooseImage">+</view>
      </view>
    </view>
  </view>

  <view class="save-bar">
    <button class="save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSave">保存</button>
  </view>

  <!-- 建筑 / 系统 / 设备：单列滚动选择 -->
  <view class="mask" wx:if="{{pickerVisible}}" bindtap="closePicker">
    <view class="picker-panel" catchtap="noop">
      <view class="picker-hd">
        <text bindtap="closePicker">取消</text>
        <text class="title">{{pickerTitle}}</text>
        <text class="confirm" bindtap="confirmPicker">确定</text>
      </view>
      <picker-view class="picker-view" value="{{pickerIndex}}" bindchange="onPickerChange">
        <picker-view-column>
          <view
            wx:for="{{pickerOptions}}"
            wx:key="value"
            class="picker-item {{pickerIndex[0] === index ? 'picker-item-active' : ''}}"
          >{{item.label}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <!-- 楼层：4列网格底部弹窗 -->
  <view class="mask" wx:if="{{floorSheetVisible}}" bindtap="closeFloorSheet">
    <view class="floor-sheet" catchtap="noop">
      <view class="floor-sheet-title">请选择一项</view>
      <scroll-view scroll-y class="floor-scroll">
        <view class="floor-grid">
          <view
            wx:for="{{floorOptions}}"
            wx:key="value"
            class="floor-cell {{form.floor === item.value ? 'active' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectFloor"
          >{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="floor-cancel" bindtap="closeFloorSheet">取消</view>
    </view>
  </view>

  <!-- 巡检时间：年/月/日三列 -->
  <view class="mask" wx:if="{{dateSheetVisible}}" bindtap="closeDateSheet">
    <view class="picker-panel" catchtap="noop">
      <view class="picker-hd">
        <text bindtap="closeDateSheet">取消</text>
        <text class="title">选择日期</text>
        <text class="confirm" bindtap="confirmDateSheet">确认</text>
      </view>
      <picker-view
        class="picker-view date-picker-view"
        value="{{datePickerValue}}"
        bindchange="onDatePickerChange"
        indicator-style="height: 80rpx;"
      >
        <picker-view-column>
          <view
            wx:for="{{years}}"
            wx:key="*this"
            class="picker-item {{tempYear === item ? 'picker-item-active' : ''}}"
          >{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view
            wx:for="{{months}}"
            wx:key="*this"
            class="picker-item {{tempMonth === item ? 'picker-item-active' : ''}}"
          >{{item}}月</view>
        </picker-view-column>
        <picker-view-column>
          <view
            wx:for="{{days}}"
            wx:key="*this"
            class="picker-item {{tempDay === item ? 'picker-item-active' : ''}}"
          >{{item}}日</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
</view>
