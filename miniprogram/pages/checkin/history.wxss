@import "../../styles/biz.wxss";

.history-card .sub {
  font-size: 24rpx;
  color: #666;
}

.history-card .value.muted {
  color: #999;
}

.photo-block {
  margin-top: 12rpx;
  padding-top: 8rpx;
}

.photo-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.photo-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eee;
}
