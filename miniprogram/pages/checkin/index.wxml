<view class="page">
  <map class="map" longitude="{{mapLongitude}}" latitude="{{mapLatitude}}" scale="16" show-location="{{true}}" enable-scroll="{{true}}" markers="{{markers}}"></map>

  <view class="sheet">
    <view class="place" bindtap="onAddressTap">{{placeTitle}}</view>
    <view class="coord-bar">
      <view class="coord-left">
        <text class="coord-text">当前位置: {{coordText}}</text>
      </view>
      <view class="{{refreshClass}}" bindtap="onRefreshTap">{{refreshText}}</view>
    </view>

    <view class="action-row">
      <view class="action-btn action-in" data-type="0" bindtap="openConfirm">签到</view>
      <view class="action-btn action-out" data-type="1" bindtap="openConfirm">签退</view>
    </view>

    <scroll-view class="history" scroll-y="true">
      <block wx:if="{{historyList.length}}">
        <view class="hist-item" wx:for="{{historyList}}" wx:key="checkInId">
          <view class="hist-dot {{item.dotClass}}"></view>
          <view class="hist-main">
            <view class="hist-top">
              <text class="hist-type {{item.typeClass}}">{{item.typeLabel}}</text>
              <text class="hist-time">{{item.displayTime}}</text>
            </view>
            <view class="hist-addr">当前位置: {{item.coordText}}</view>
          </view>
        </view>
      </block>
      <view class="hist-empty" wx:if="{{!historyList.length && !historyLoading}}">暂无签到记录</view>
      <view class="hist-empty" wx:if="{{!historyList.length && historyLoading}}">加载中...</view>
    </scroll-view>
  </view>

  <view class="mask" wx:if="{{showConfirm}}" catchtouchmove="noop">
    <view class="confirm" catchtap="noop">
      <view class="confirm-hd">
        <text class="confirm-title">{{confirmTitle}}</text>
        <text class="confirm-close" bindtap="closeConfirm">X</text>
      </view>

      <view class="field">
        <view class="field-label">关联任务(可选)</view>
        <picker mode="selector" range="{{taskList}}" range-key="taskName" value="{{taskPickerValue}}" bindchange="onTaskChange">
          <view class="field-picker">{{taskPickerText}}</view>
        </picker>
      </view>

      <view class="field">
        <view class="field-label">现场照片(必传)</view>
        <view class="photos">
          <block wx:for="{{images}}" wx:key="index">
            <view class="thumb-wrap">
              <image class="thumb" src="{{item.tempPath || item.serverUrl}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage"></image>
              <view class="thumb-del" data-index="{{index}}" catchtap="removeImage">X</view>
              <view class="thumb-mask" wx:if="{{item.uploading}}">图片上传中</view>
            </view>
          </block>
          <view class="thumb-add" wx:if="{{canAddImage}}" bindtap="chooseImage">
            <text class="plus">+</text>
            <text class="plus-text">上传图片</text>
          </view>
        </view>
      </view>

      <view class="field">
        <view class="field-label">备注</view>
        <textarea class="remark" value="{{remark}}" bindinput="onRemarkInput" maxlength="200"></textarea>
      </view>

      <view class="{{submitClass}}" bindtap="handleSubmit">{{submitText}}</view>
    </view>
  </view>
</view>
