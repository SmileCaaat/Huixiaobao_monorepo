<view class="checkin-page">
  <view class="checkin-page__company">
    <text class="checkin-page__company-label">当前公司</text>
    <text class="checkin-page__company-name">{{companyName}}</text>
  </view>

  <view class="checkin-page__body">
    <view class="checkin-page__section">
      <view class="checkin-page__section-title">定位信息</view>
      <view class="checkin-page__card">
        <view class="checkin-page__row">
          <text class="checkin-page__label">纬度</text>
          <text class="checkin-page__value">{{latitude != null ? latitude : "-"}}</text>
        </view>
        <view class="checkin-page__row">
          <text class="checkin-page__label">经度</text>
          <text class="checkin-page__value">{{longitude != null ? longitude : "-"}}</text>
        </view>
        <view class="checkin-page__row checkin-page__row--addr">
          <text class="checkin-page__label">地址</text>
          <text class="checkin-page__value checkin-page__addr {{addressFailed ? 'is-error' : ''}}">{{addressText}}</text>
        </view>
        <view class="checkin-page__refresh {{locating ? 'is-disabled' : ''}}" bindtap="onLocationAction">{{locating ? "定位中..." : (addressFailed ? "选择位置" : "刷新定位")}}</view>
      </view>
    </view>

    <view class="checkin-page__section">
      <view class="checkin-page__section-title">签到类型</view>
      <view class="checkin-page__type-card">
        <view class="checkin-page__type-item {{checkInType === '0' ? 'is-active' : ''}}" data-type="0" bindtap="onTypeTap">签到</view>
        <view class="checkin-page__type-item {{checkInType === '1' ? 'is-active' : ''}}" data-type="1" bindtap="onTypeTap">签退</view>
      </view>
    </view>

    <view class="checkin-page__section">
      <view class="checkin-page__section-title">维保任务</view>
      <view class="checkin-page__card checkin-page__card--task">
        <picker mode="selector" range="{{taskList}}" range-key="taskName" value="{{taskIndex >= 0 ? taskIndex : 0}}" bindchange="onTaskChange">
          <view class="checkin-page__picker">{{selectedTaskName || "请选择任务（必选）"}}</view>
        </picker>
      </view>
    </view>

    <view class="checkin-page__section">
      <view class="checkin-page__section-title">现场照片</view>
      <view class="checkin-page__photos">
        <block wx:for="{{images}}" wx:key="index">
          <view class="checkin-page__thumb-wrap">
            <image class="checkin-page__thumb" src="{{item.tempPath || item.serverUrl}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
            <view class="checkin-page__thumb-del" data-index="{{index}}" catchtap="removeImage">×</view>
            <view class="checkin-page__thumb-mask" wx:if="{{item.uploading}}">上传中</view>
          </view>
        </block>
        <view class="checkin-page__thumb-add" wx:if="{{images.length < 2}}" bindtap="chooseImage">+</view>
      </view>
    </view>

    <view class="checkin-page__section">
      <view class="checkin-page__remark">
        <text class="checkin-page__remark-label">备注</text>
        <textarea class="checkin-page__remark-input" value="{{remark}}" bindinput="onRemarkInput" maxlength="200" auto-height="{{false}}" />
      </view>
    </view>
  </view>

  <view class="checkin-page__actions">
    <view class="checkin-page__btn checkin-page__btn--ghost" bindtap="goHistory">查看签到历史</view>
    <view class="checkin-page__btn checkin-page__btn--primary {{submitting ? 'is-disabled' : ''}}" bindtap="handleSubmit">提交打卡</view>
  </view>
</view>
