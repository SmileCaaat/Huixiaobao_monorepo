<view class="page">
  <block wx:if="{{list.length}}">
    <view class="card history-card" wx:for="{{list}}" wx:key="checkInId">
      <view class="card-hd">
        <view class="badge {{item.checkInType === '1' ? 'badge-warn' : 'badge-ok'}}">{{item.checkInType === '1' ? '签退' : '签到'}}</view>
        <view class="sub">{{item.displayTime || item.checkInTime || item.createTime}}</view>
      </view>
      <view class="row">
        <view class="label">任务</view>
        <view class="value">{{item.taskName || '-'}}</view>
      </view>
      <view class="row">
        <view class="label">地址</view>
        <view class="value">{{item.address || item.checkInAddress || '-'}}</view>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!loading && !list.length}}">暂无签到记录</view>
  <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
  <view class="footer-tip" wx:if="{{!loading && !hasMore && list.length}}">没有更多了</view>
  <view class="footer-tip" wx:if="{{!loading && hasMore && list.length}}">上拉加载更多</view>
</view>
