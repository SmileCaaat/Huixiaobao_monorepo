<view class="page">
  <block wx:if="{{list.length}}">
    <view class="card history-card" wx:for="{{list}}" wx:key="checkInId">
      <view class="card-hd">
        <view class="badge {{item.typeClass}}">{{item.typeLabel}}</view>
        <view class="sub">{{item.displayTime}}</view>
      </view>
      <view class="row">
        <view class="label">客户</view>
        <view class="value">{{item.companyName}}</view>
      </view>
      <view class="row">
        <view class="label">地址</view>
        <view class="value">{{item.addressText}}</view>
      </view>
      <view class="row">
        <view class="label">签到时间</view>
        <view class="value">{{item.displayTime || '-'}}</view>
      </view>
      <view class="photo-block" wx:if="{{item.previewImages.length}}">
        <view class="photo-label">打卡照片</view>
        <view class="photo-row">
          <image
            class="photo"
            wx:for="{{item.previewImages}}"
            wx:for-item="img"
            wx:for-index="imgIndex"
            wx:key="imgIndex"
            src="{{img}}"
            mode="aspectFill"
            data-id="{{item.checkInId}}"
            data-current="{{img}}"
            bindtap="previewImage"
          />
        </view>
      </view>
      <view class="row" wx:else>
        <view class="label">打卡照片</view>
        <view class="value muted">暂无照片</view>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!loading && !list.length}}">暂无签到记录</view>
  <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
  <view class="footer-tip" wx:if="{{!loading && !hasMore && list.length}}">没有更多了</view>
  <view class="footer-tip" wx:if="{{!loading && hasMore && list.length}}">上拉加载更多</view>
</view>
