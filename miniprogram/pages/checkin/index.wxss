.page{height:100vh;display:flex;flex-direction:column;background:#f5f5f5;overflow:hidden;}
.map{width:100%;height:42vh;}
.sheet{flex:1;min-height:0;margin-top:-24rpx;background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));box-sizing:border-box;display:flex;flex-direction:column;position:relative;z-index:2;box-shadow:0 -8rpx 24rpx rgba(0,0,0,.06);}
.place{font-size:36rpx;font-weight:700;color:#222;line-height:1.35;margin-bottom:16rpx;}
.coord-bar{display:flex;align-items:center;justify-content:space-between;background:#f3f4f6;border-radius:12rpx;padding:14rpx 16rpx;margin-bottom:22rpx;}
.coord-left{flex:1;min-width:0;display:flex;align-items:center;gap:10rpx;}
.coord-icon{color:#9aa0a6;font-size:18rpx;}
.coord-text{color:#666;font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.coord-actions{flex-shrink:0;margin-left:12rpx;display:flex;align-items:center;gap:12rpx;}
.refresh-btn{flex-shrink:0;padding:8rpx 22rpx;border-radius:999rpx;border:1px solid #4a90e2;color:#4a90e2;background:#fff;font-size:24rpx;}
.refresh-btn.disabled{opacity:.55;}
.history-btn{flex-shrink:0;padding:8rpx 22rpx;border-radius:999rpx;border:1px solid #e53935;color:#e53935;background:#fff;font-size:24rpx;}
.action-row{display:flex;gap:20rpx;margin-bottom:20rpx;}
.action-btn{flex:1;height:88rpx;line-height:88rpx;text-align:center;border-radius:16rpx;color:#fff;font-size:32rpx;font-weight:600;}
.action-in{background:#3b82f6;}
.action-out{background:#ef5350;}
.history{flex:1;min-height:0;}
.hist-item{display:flex;align-items:flex-start;padding:18rpx 0;border-bottom:1px solid #f0f0f0;}
.hist-dot{width:16rpx;height:16rpx;border-radius:50%;margin-top:12rpx;margin-right:16rpx;flex-shrink:0;}
.hist-dot.is-in{background:#3b82f6;}
.hist-dot.is-out{background:#ef5350;}
.hist-main{flex:1;min-width:0;}
.hist-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:6rpx;}
.hist-type{font-size:28rpx;font-weight:600;}
.hist-type.is-in{color:#3b82f6;}
.hist-type.is-out{color:#ef5350;}
.hist-time{color:#999;font-size:24rpx;}
.hist-addr{color:#888;font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.hist-empty{text-align:center;color:#bbb;font-size:24rpx;padding:40rpx 0;}
.mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.45);z-index:100;display:flex;align-items:flex-end;}
.confirm{width:100%;background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));box-sizing:border-box;}
.confirm-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx;}
.confirm-title{font-size:34rpx;font-weight:700;color:#222;}
.confirm-close{width:56rpx;height:56rpx;line-height:56rpx;text-align:center;font-size:34rpx;color:#999;}
.field{margin-bottom:24rpx;}
.field-label{font-size:28rpx;color:#333;margin-bottom:12rpx;font-weight:600;}
.field-picker{height:80rpx;line-height:80rpx;padding:0 24rpx;background:#f5f6f8;border-radius:12rpx;color:#666;font-size:28rpx;position:relative;}
.photos{display:flex;flex-wrap:wrap;gap:16rpx;}
.thumb-wrap,.thumb-add{width:160rpx;height:160rpx;position:relative;}
.thumb{width:160rpx;height:160rpx;border-radius:12rpx;background:#eee;display:block;}
.thumb-add{border:2rpx dashed #ccc;border-radius:12rpx;background:#fafafa;display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box;color:#999;}
.plus{font-size:48rpx;line-height:1;color:#bbb;}
.plus-text{font-size:22rpx;margin-top:6rpx;}
.thumb-del{position:absolute;top:-10rpx;right:-10rpx;width:36rpx;height:36rpx;line-height:32rpx;text-align:center;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:22rpx;z-index:2;}
.thumb-mask{position:absolute;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.35);color:#fff;font-size:22rpx;display:flex;align-items:center;justify-content:center;border-radius:12rpx;}
.remark{width:100%;min-height:120rpx;padding:18rpx 20rpx;box-sizing:border-box;background:#f5f6f8;border-radius:12rpx;font-size:28rpx;color:#333;}
.confirm-btn{margin-top:8rpx;height:92rpx;line-height:92rpx;text-align:center;border-radius:16rpx;background:#e53935;color:#fff;font-size:32rpx;font-weight:700;}
.confirm-btn.disabled{opacity:.6;}
