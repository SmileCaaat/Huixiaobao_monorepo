.page {
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
  padding: 24rpx;
}

.info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.company-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 28rpx;
  line-height: 1.4;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #222;
  font-weight: 600;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #111;
  line-height: 1.5;
  word-break: break-all;
}

.value.phone {
  color: #e53935;
}

.loading {
  text-align: center;
  color: #666;
  padding: 80rpx 24rpx;
  font-size: 26rpx;
}
