<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索客户名称或地址" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" />
    <view class="search-btn" bindtap="onSearchConfirm">搜索</view>
  </view>

  <block wx:if="{{filteredList.length}}">
    <view class="card customer-card" wx:for="{{filteredList}}" wx:key="companyId" data-id="{{item.companyId}}" bindtap="onTapCard">
      <view class="card-hd">
        <view class="title">{{item.companyName}}</view>
        <view class="badge {{item.status === '0' ? 'badge-ok' : 'badge-muted'}}">{{item.status === '0' ? '正常' : '停用'}}</view>
      </view>
      <view class="row">
        <view class="label">地址</view>
        <view class="value">{{item.address || '暂无地址'}}</view>
      </view>
      <view class="row">
        <view class="label">联系人</view>
        <view class="value">{{item.contactPerson || '暂无联系人'}}</view>
      </view>
      <view class="row phone-row" wx:if="{{item.contactPhone}}">
        <view class="label">电话</view>
        <view class="value phone-link" data-phone="{{item.contactPhone}}" catchtap="onCallPhone">{{item.contactPhone}}</view>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!loading && !filteredList.length}}">暂无客户</view>
  <view class="footer-tip" wx:if="{{loading}}">加载中...</view>
</view>
